{
    "name": "@codesema/speccov",
    "version": "0.1.0",
    "description": "Finds the behaviours no rule guarantees, and puts them as questions.",
    "type": "module",
    "license": "MIT",
    "author": "Hasan TASKIN",
    "keywords": [
        "ast",
        "codesema",
        "hardening",
        "n-plus-one",
        "property-based-testing",
        "static-analysis",
        "typescript"
    ],
    "engines": {
        "bun": ">=1.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "speccov": "./src/cli.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./typeorm": "./src/adapters/typeorm.ts"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/scan/virtual-program.ts"
    ],
    "scripts": {
        "prepare": "lefthook install || echo \"WARNING: lefthook install failed — git hooks are NOT active (no secret scan, no format or lint on commit). Run `bun run prepare` again once git and lefthook are available.\"",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "format": "prettier --write . --cache",
        "format:check": "prettier --check . --cache",
        "verify": "bun run typecheck && bun run lint && bun test"
    },
    "dependencies": {
        "typescript": "^5.9.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@types/bun": "latest",
        "better-sqlite3": "^13.0.3",
        "lefthook": "^2.1.10",
        "oxlint": "^1.80.0",
        "pg": "^8.23.0",
        "prettier": "^3.9.6",
        "typeorm": "^1.1.0"
    }
}
