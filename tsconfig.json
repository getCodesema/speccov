{
    "compilerOptions": {
        "target": "ES2023",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "types": ["bun"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src", "examples"]
}
